<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>バランス献立アプリ</title>
    <style>
        :root {
            --primary: #557A46;
            --primary-light: #739E62;
            --primary-dark: #3F5E33;
            --bg-color: #F7F9F5;
            --card-bg: #FFFFFF;
            --text-main: #333333;
            --text-sub: #666666;
            --border-color: #DDE5D6;
            --radius: 16px;
            --shadow: 0 4px 16px rgba(85, 122, 70, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            padding: 20px;
            display: flex;
            justify-content: center;
        }

        .app-container {
            width: 100%;
            max-width: 480px;
            background-color: var(--card-bg);
            border-radius: 24px;
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            height: 90vh;
            max-height: 800px;
            overflow: hidden;
        }

        .app-header {
            background-color: var(--primary);
            color: white;
            padding: 16px 20px;
            font-size: 1.1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            background: #FAFAFA;
        }

        .chat-row {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            max-width: 90%;
            animation: fadeIn 0.3s ease-in-out;
        }

        .chat-row.app {
            align-self: flex-start;
        }

        .chat-row.user {
            align-self: flex-end;
            flex-direction: row-reverse;
        }

        .chibi-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            overflow: hidden;
            background: #EAEFE5;
            border: 2px solid var(--primary);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.05);
        }

        .chibi-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .bubble {
            padding: 14px 16px;
            border-radius: 18px;
            font-size: 0.95rem;
            line-height: 1.5;
            box-shadow: 0 2px 6px rgba(0,0,0,0.03);
            white-space: pre-line;
        }

        .chat-row.app .bubble {
            background: white;
            color: var(--text-main);
            border: 1px solid var(--border-color);
            border-bottom-left-radius: 4px;
        }

        .chat-row.user .bubble {
            background: var(--primary);
            color: white;
            border-bottom-right-radius: 4px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .options-area {
            padding: 16px 20px;
            background: white;
            border-top: 1px solid var(--border-color);
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .option-btn {
            background: white;
            border: 2px solid var(--primary);
            color: var(--primary);
            padding: 12px 16px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            text-align: left;
            transition: all 0.2s;
        }

        .option-btn:hover {
            background: var(--primary);
            color: white;
        }

        .day-card {
            background: white;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            overflow: hidden;
            margin-bottom: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            width: 100%;
        }

        .day-header {
            background: var(--primary-light);
            color: white;
            padding: 8px 14px;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .meal-row {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border-color);
            font-size: 0.9rem;
            cursor: pointer;
            transition: background 0.2s;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .meal-row:hover {
            background-color: #F2F7ED;
        }

        .meal-row:last-child {
            border-bottom: none;
        }

        .meal-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .meal-type {
            font-weight: 700;
            color: var(--primary-dark);
            font-size: 0.8rem;
        }

        .recipe-hint {
            font-size: 0.75rem;
            color: var(--primary);
            background: #EAF3E5;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
            white-space: nowrap;
        }

        /* レシピ詳細カード（チャット内） */
        .recipe-box {
            background: #F9FBF7;
            border: 1px solid var(--primary-light);
            border-radius: 12px;
            padding: 12px;
            margin-top: 8px;
            font-size: 0.9rem;
        }

        .recipe-title {
            font-weight: 700;
            color: var(--primary-dark);
            margin-bottom: 6px;
            font-size: 1rem;
            border-bottom: 1px dashed var(--border-color);
            padding-bottom: 4px;
        }

        .recipe-section-title {
            font-weight: 700;
            color: var(--primary);
            margin-top: 8px;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<div class="app-container">
    <div class="app-header">
        🥗 バランス献立パートナー
    </div>

    <div class="chat-container" id="chatContainer"></div>

    <div class="options-area" id="optionsArea"></div>
</div>


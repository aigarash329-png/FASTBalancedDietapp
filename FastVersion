    };

    let userData = { mood: '', people: '', style: '' };

    const chatContainer = document.getElementById('chatContainer');
    const optionsArea = document.getElementById('optionsArea');

    function addBubble(text, faceKey = 'hello') {
        const row = document.createElement('div');
        row.className = 'chat-row app';

        const avatarImgSrc = chibiFaces[faceKey] || chibiFaces.hello;

        const avatar = document.createElement('div');
        avatar.className = 'chibi-avatar';
        avatar.innerHTML = `<img src="${avatarImgSrc}" alt="ちびキャラ" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' width=\'24\' height=\'24\'><circle cx=\'12\' cy=\'12\' r=\'10\' fill=\'%23557A46\'/><text x=\'12\' y=\'16\' font-size=\'12\' fill=\'white\' text-anchor=\'middle\'>😊</text></svg>'">`;
        row.appendChild(avatar);

        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.innerText = text;
        row.appendChild(bubble);

        chatContainer.appendChild(row);
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    function clearOptions() {
        optionsArea.innerHTML = '';
    }

    function startChat() {
        addBubble("こんにちは！今週のごはんを一緒に楽しく考えましょう♪\nまず、今のあなたの体調や気分に一番近いものはどれですか？", "hello");
        
        showOptions([
            { text: "✨ すっきり元気！しっかり動きたい", next: () => selectMood("元気") },
            { text: "🍵 少しお疲れ気味で、ホッとひと息つきたい", next: () => selectMood("お疲れ") },
            { text: "🌿 胃腸を休めて、優しく労わりたい", next: () => selectMood("労わりたい") }
        ]);
    }

    function showOptions(options) {
        clearOptions();
        options.forEach(opt => {
            const btn = document.createElement('button');
            btn.className = 'option-btn';
            btn.innerText = opt.text;
            btn.onclick = () => {
                const userRow = document.createElement('div');
                userRow.className = 'chat-row user';
                userRow.innerHTML = `<div class="bubble">${opt.text}</div>`;
                chatContainer.appendChild(userRow);
                chatContainer.scrollTop = chatContainer.scrollHeight;
                
                clearOptions();
                opt.next();
            };
            optionsArea.appendChild(btn);
        });
    }

    function selectMood(mood) {
        userData.mood = mood;
        setTimeout(() => {
            const nextFace = mood === '元気' ? 'think' : 'releved';
            addBubble(`教えてくれてありがとう！続いて、何人分のごはんを作りますか？`, nextFace);
            
            showOptions([
                { text: "👤 1人分", next: () => selectPeople("1人分") },
                { text: "👥 2人分", next: () => selectPeople("2人分") },
                { text: "👨‍👩‍👧 3〜4人分", next: () => selectPeople("3〜4人分") }
            ]);
        }, 500);
    }

    function selectPeople(people) {
        userData.people = people;
        setTimeout(() => {
            addBubble("おっけー！最後に、お好みの食事スタイルを教えてね。", "suggestion");
            
            showOptions([
                { text: "🥩 肉も魚もバランスよく食べたい", next: () => selectStyle("バランス") },
                { text: "🐟 魚・シーフード中心にしたい", next: () => selectStyle("魚中心") },
                { text: "🌱 野菜や大豆中心にヘルシーにいきたい", next: () => selectStyle("野菜中心") }
            ]);
        }, 500);
    }

    function selectStyle(style) {
        userData.style = style;
        setTimeout(() => {
            addBubble("あなたの気分やスタイルに合わせて、今週の献立を組み立てるね…✨\n気になったメニューをポチッと押すと、材料や作り方も教えるね！", "surprise");
            
            setTimeout(() => {
                showMenuResult();
            }, 1200);
        }, 500);
    }

    function showMenuResult() {
        addBubble(`お待たせしました！\n(${userData.people} ／ スタイル: ${userData.style} ／ 気分: ${userData.mood}) に合わせた今週の献立一覧です♪\n\n👇 **気になるメニューを押してみてね！**`, "happy");

        const menuContainer = document.createElement('div');
        menuContainer.style.display = 'flex';
        menuContainer.style.flexDirection = 'column';
        menuContainer.style.gap = '8px';
        menuContainer.style.width = '100%';

        const days = [
            { day: '月曜日', b: '全粒粉トーストとスクランブルエッグ', l: '具だくさんミネストローネ', d: '旬野菜とサーモンのハーブホイル焼き' },
            { day: '火曜日', b: 'お豆腐とワカメの和風スープ', l: 'ラップサンドイッチ', d: '豚肉とたっぷりキノコの生姜焼き' },
            { day: '水曜日', b: 'アボカドチーズトースト', l: 'レンズ豆と根菜のポトフ', d: '白身魚のふんわり和風あんかけ' },
            { day: '木曜日', b: 'ギリシャヨーグルトと果物', l: 'ツナとブロッコリーの全粒粉パスタ', d: 'ひき肉と彩りピーマンのドライカレー' },
            { day: '金曜日', b: '温かい豆乳スープと米粉パン', l: '鶏ささみサラダボウル', d: '大豆と根菜のほっこり和風煮物' },
            { day: '土曜日', b: 'ほうれん草と卵のココット風', l: '海藻と豆腐のさっぱり和風丼', d: 'チキンと夏野菜のトマト煮込み' },
            { day: '日曜日', b: '和風モーニングプレート', l: 'お豆と雑穀のスープ', d: '手作り餃子と中華スープ' }
        ];

        days.forEach(item => {
            const card = document.createElement('div');
            card.className = 'day-card';
            
            let cardHtml = `<div class="day-header">${item.day}</div>`;
            
            ['朝: ' + item.b, '昼: ' + item.l, '夕: ' + item.d].forEach(mealText => {
                const dishName = mealText.split(': ')[1];
                const typeLabel = mealText.split(': ')[0];
                
                cardHtml += `
                    <div class="meal-row" onclick="showRecipe('${dishName}')">
                        <div class="meal-info">
                            <span class="meal-type">${typeLabel}</span>
                            <span style="font-weight: 600; color: var(--text-main);">${dishName}</span>
                        </div>
                        <span class="recipe-hint">レシピを見る 📖</span>
                    </div>
                `;
            });

            card.innerHTML = cardHtml;
            menuContainer.appendChild(card);
        });

        chatContainer.appendChild(menuContainer);
        chatContainer.scrollTop = chatContainer.scrollHeight;

        showOptions([
            { text: "🔄 最初からもう一度相談する", next: () => { chatContainer.innerHTML = ''; startChat(); } }
        ]);
    }

    // レシピを表示する関数
    function showRecipe(dishName) {
        const recipe = recipeDatabase[dishName] || {
            ingredients: '・お好みの食材',
            steps: '1. 食材を食べやすく切る。\n2. 調味料で味を調えて調理する。',
            tip: '🌿 バランスよく栄養を摂って、美味しく元気に過ごしましょう！'
        };

        // ちびキャラがレシピを教えてくれる吹き出しを表示
        const row = document.createElement('div');
        row.className = 'chat-row app';

        const avatar = document.createElement('div');
        avatar.className = 'chibi-avatar';
        avatar.innerHTML = `<img src="${chibiFaces.suggestion}" alt="ちびキャラ" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\' width=\'24\' height=\'24\'><circle cx=\'12\' cy=\'12\' r=\'10\' fill=\'%23557A46\'/><text x=\'12\' y=\'16\' font-size=\'12\' fill=\'white\' text-anchor=\'middle\'>💡</text></svg>'">`;
        row.appendChild(avatar);

        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.innerHTML = `
            「${dishName}」の作り方とポイントだね！✨
            <div class="recipe-box">
                <div class="recipe-title">🍳 ${dishName}</div>
                <div class="recipe-section-title">【材料】</div>
                <div style="white-space: pre-line; margin-bottom: 6px;">${recipe.ingredients}</div>
                <div class="recipe-section-title">【かんたん作り方】</div>
                <div style="white-space: pre-line; margin-bottom: 6px;">${recipe.steps}</div>
                <div class="recipe-section-title">【💡 ナチュラルフードのポイント】</div>
                <div>${recipe.tip}</div>
            </div>
        `;
        row.appendChild(bubble);

        chatContainer.appendChild(row);
        chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    startChat();
</script>

</body>
</html>
